NOTE_NO_OCR = ("> NOTE: little text extracted — likely scanned or image-based. "
               "Read the original PDF directly.")
NOTE_AFTER_OCR = ("> NOTE: little text extracted even with OCR — likely images or handwriting. "
                  "Read the original PDF directly.")
