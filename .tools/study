def cmd_setup(mode=None):
    hw = hardware()
    rec, why = recommend(hw)
    mode = mode or rec
    if mode not in ("auto", "cpu", "off"):
        sys.exit("--mode must be auto, cpu or off")
    if mode != "off" and rec == "off":
        sys.exit(f"Not supported on this machine: {why}. Use --mode off (Grep only).")
    print(f"Mode: {mode}" + (f"  ({why})" if mode == rec else ""))

    device = {"off": "off", "cpu": "cpu", "auto": "gpu"}[mode]
    CONFIG.write_text(json.dumps({"mode": mode, "index_device": device,
                                  "search_device": device}, indent=2) + "\n")
    print(f"Saved {CONFIG.relative_to(ROOT)}")
    if mode == "off":
        print("The tutor will use Grep over converted/. Run `study setup` again any time to change.")
        return

    semantic.cmd_install()
    for task in ("index", "search"):
        subprocess.run([sys.executable, str(SEMANTIC), "check", task], check=True)
    if (ROOT / ".tools/.venv").exists():
        print("Note: .tools/.venv (the old PyTorch setup, ~1 GB) is no longer used and can be deleted.")
    for s in subjects():
        if any((ROOT / s / "converted").rglob("*.md")):
            print(f"-> indexing {s}", flush=True)
            cmd_index(s)
    print("Done. Try: study search <Subject> \"<topic in plain words>\"")


def cmd_index(name):
    sd = subject_dir(name)
    require_semantic()
    idx = INDEX_DIR / sd.name
    subprocess.run([sys.executable, str(SEMANTIC), "index", str(sd / "converted"), str(idx)], check=True)


def cmd_search(name, query, k):
    sd = subject_dir(name)
    require_semantic()
    idx = INDEX_DIR / sd.name
    subprocess.run([sys.executable, str(SEMANTIC), "search", str(sd / "converted"), str(idx),
                    str(k), query], check=True)


def queue_path(sd):
    return sd / "queue.jsonl"


def load_queue(sd):
    p = queue_path(sd)
    return [json.loads(l) for l in p.read_text().splitlines() if l.strip()] if p.exists() else []


def save_queue(sd, items):
    queue_path(sd).write_text("".join(json.dumps(i, ensure_ascii=False) + "\n" for i in items))


def online(timeout=2.5):
    try:
        urllib.request.urlopen(CONNECT_URL, timeout=timeout)
        return True
    except urllib.error.HTTPError:
        return True  # the server answered: we are online
    except Exception:
        return False


def retrieve(sd, question, k=3):
    """[(score, 'pdfs/File.pdf p.N', text)] for a question, most relevant first."""
    hits = semantic.rank(sd / "converted", INDEX_DIR / sd.name, k, question)
    return [(s, f"{n}{(' ' + c['loc']) if c['loc'] else ''}", c["text"]) for s, n, c in hits]


def enqueue(sd, question, why, top, refs):
    qid = hashlib.sha1(" ".join(question.lower().split()).encode()).hexdigest()[:10]
    items = load_queue(sd)
    existing = next((i for i in items if i["id"] == qid), None)
    if existing and existing["status"] in ("pending", "ready"):
        print("Already in the queue.")
        return
    if existing:  # asked before and already resolved — ask again
        existing.update(why=why, top=round(top, 3), ctx=refs, status="pending",
                        ts=time.strftime("%Y-%m-%d"))
    else:
        items.append({"id": qid, "ts": time.strftime("%Y-%m-%d"), "q": question, "why": why,
                      "top": round(top, 3), "ctx": refs, "status": "pending"})
    save_queue(sd, items)
    reason = ("this isn't in your notes" if why == "ungrounded" else "this needs reasoning")
    n = sum(i["status"] == "pending" for i in items)
    print(f"Not sure yet — {reason}. Saved for Claude when you're back online. [{n} waiting]")


def cmd_ask(name, question):
    sd = subject_dir(name)
    require_semantic()
    hits = retrieve(sd, question)
    top = hits[0][0] if hits else 0.0
    refs = [r for _, r, _ in hits]
    if top < GROUND_THRESHOLD:
        enqueue(sd, question, "ungrounded", top, refs)  # not in the materials
        return
    if REASON_RE and REASON_RE.search(question):
        # reasoning-type question -> escalate; the local model never tries to reason or invent
        enqueue(sd, question, "needs_reasoning", top, refs)
        return
    # plain grounded lookup: show the student's own passage (cleaned, not generated — no hallucination)
    show_passage(hits, top)


def _load_noise():
    """Per-install boilerplate filters: one regex per line in .tools/noise.txt (gitignored, so your
    course's headers/footers never ship in the template). None by default — see noise.txt.example."""
    pats, f = [], ROOT / ".tools/noise.txt"
    if f.exists():
        for line in f.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                try:
                    pats.append(re.compile(line))
                except re.error:
                    pass
    return pats


NOISE_PATTERNS = _load_noise()


def clean_passage(text, limit=260):
    """A short readable lead: keep the first sentence(s); strip any boilerplate from .tools/noise.txt.
    PDF columns often merge into one long run with no periods — then we show the clean opening."""
    t = " ".join(text.split())
    for pat in NOISE_PATTERNS:
        t = pat.sub("", t)
    t = re.sub(r"\s{2,}", " ", t).strip()
    t = re.sub(r"\b([\w ]{3,40}?)\s+\1\b", r"\1", t)  # collapse a repeated slide-title phrase
    out = ""
    for s in re.split(r"(?<=[.!?]) ", t):
        if out and len(out) + 1 + len(s) > limit:
            break
        out = f"{out} {s}".strip()
        if len(out) >= limit - 60:
            break
    return out + (" …" if len(out) < len(t) else "")


def show_passage(hits, top):
    _, ref, text = hits[0]
    print(clean_passage(text))
    print(f"  ↳ your notes · {ref.split('/')[-1].replace('.pdf', '')}")


def _parse_date(s):
    for fmt in ("%Y-%m-%d", "%d.%m.%Y", "%d.%m.%y"):
        try:
            return datetime.datetime.strptime(s.strip(), fmt).date()
        except ValueError:
            pass
    return None


def _progress_rows(sd):
    """Yield [topic, level, last, next_review, ...] for each data row of progress.md."""
    p = sd / "progress.md"
    if not p.exists():
        return
    for line in p.read_text().splitlines():
        if not line.startswith("| ") or line.startswith("| Topic") or set(line) <= set("| -"):
            continue
        yield [c.strip() for c in line.strip("|").split("|")]


def due_topics(sd):
    today = datetime.date.today()
    out = []
    for cols in _progress_rows(sd):
        if len(cols) >= 4:
            d = _parse_date(cols[3])
            if d and d <= today:
                out.append(cols[0])
    return out


def next_new_topic(sd):
    for cols in _progress_rows(sd):
        if len(cols) >= 2 and cols[1] == "0":
            return cols[0]
    return None


def next_deadline_days(sd):
    p = sd / "CLAUDE.md"
    if not p.exists():
        return None
    today, best = datetime.date.today(), None
    for m in re.finditer(r"\d{4}-\d\d-\d\d|\d{1,2}\.\d{1,2}\.\d{2,4}", p.read_text()):
        d = _parse_date(m.group(0))
        if d and d >= today and (best is None or d < best):
            best = d
    return (best - today).days if best else None


def tutor_banner(sd):
    bits = [sd.name]
    days = next_deadline_days(sd)
    if days is not None:
        bits.append(f"next deadline in {days}d")
    bits.append(f"due to review: {len(due_topics(sd))}")
    pend = sum(i["status"] == "pending" for i in load_queue(sd))
    if pend:
        bits.append(f"queued: {pend}")
    cards = sd / "cards" / "escalated.md"
    n = cards.read_text().count("\n## ") if cards.exists() else 0
    if n:
        bits.append(f"cards ready: {n}")
    return "  ·  ".join(bits)


def tutor_turn(sd, message, searcher=None, session=None):
    """One agent turn: the local model picks a tool, deterministic rails keep it honest.
    Pass a warm searcher/session (REPL) to avoid reloading the models each line."""
    def topk(q, k=3):
        if searcher is not None:
            hits = searcher.topk(q, k)
            return [(s, f"{n}{(' ' + c['loc']) if c['loc'] else ''}", c["text"]) for s, n, c in hits]
        return retrieve(sd, q, k)

    if session is not None:
        tool, query = session.route(message)
    elif chat.installed():
        tool, query = chat.route(message)
    else:
        tool, query = ("escalate" if (REASON_RE and REASON_RE.search(message)) else "search"), message
    if tool == "search" and REASON_RE and REASON_RE.search(message):
        tool = "escalate"  # rail: reasoning always escalates, even if the tiny model said search
    if tool == "search":
        hits = topk(query)
        top = hits[0][0] if hits else 0.0
        if top >= GROUND_THRESHOLD:
            show_passage(hits, top)
            return
        enqueue(sd, message, "ungrounded", top, [r for _, r, _ in hits])  # rail: weak retrieval escalates
        return
    hits = topk(message)
    enqueue(sd, message, "needs_reasoning", hits[0][0] if hits else 0.0, [r for _, r, _ in hits])


def cmd_tutor(name, message):
    sd = subject_dir(name)
    require_semantic()
    if not chat.installed():
        sys.exit("Local orchestrator model is not installed (.tools/models/Qwen3.5-0.8B-Q8_0.gguf).")
    tutor_turn(sd, message)


def cmd_tutor_repl(name):
    """Interactive session: keep both models warm; type questions, 'queue', or 'exit'."""
    sd = subject_dir(name)
    require_semantic()
    print(tutor_banner(sd))
    print("ask in plain words · 'next' = what to study · 'queue' = what's waiting · 'exit'"
          + ("" if claude_cli() else "   (no `claude` CLI — queued questions stay for later)"))
    stop = threading.Event()

    def watcher():
        """In the background: whenever there's a connection, let Claude clear any queued questions."""
        while not stop.wait(8):
            pending = [i for i in load_queue(sd) if i["status"] == "pending"]
            if pending and claude_cli() and online():
                print(f"\n[auto] online — asking Claude to clear {len(pending)} queued "
                      f"question(s)...", flush=True)
                answers = resolve_with_claude(sd, pending)
                items, done = load_queue(sd), 0
                for it in items:
                    if it["status"] == "pending" and answers.get(it["id"]):
                        write_card(sd, it, answers[it["id"]])
                        it["status"] = "resolved"
                        done += 1
                save_queue(sd, items)
                print(f"[auto] done — {done} answer(s) now in cards (type 'cards' to read).")
                print(f"{sd.name}> ", end="", flush=True)

    with semantic.Searcher(sd / "converted", INDEX_DIR / sd.name) as searcher:
        threading.Thread(target=watcher, daemon=True).start()

        def loop(session):
            while True:
                try:
                    line = input(f"\n{sd.name}> ").strip()
                except EOFError:
                    break
                if not line:
                    continue
                if line in ("exit", "quit"):
                    break
                if line == "queue":
                    cmd_queue(name)
                    continue
                if line == "cards":
                    cmd_cards(name)
                    continue
                if line == "next":
                    due = due_topics(sd)
                    if due:
                        print("Due today: " + ", ".join(due))
                    else:
                        nt = next_new_topic(sd)
                        print(f"Nothing due. Next new topic: {nt}" if nt else "Nothing due; no new topics.")
                    continue
                tutor_turn(sd, line, searcher=searcher, session=session)
        try:
            if chat.installed():
                with chat.Session() as session:
                    loop(session)
            else:
                loop(None)
        finally:
            stop.set()
    print("bye")


def cmd_cards(name):
    sd = subject_dir(name)
    card = sd / "cards" / "escalated.md"
    text = card.read_text().strip() if card.exists() else ""
    if not text:
