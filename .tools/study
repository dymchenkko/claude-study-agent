#!/usr/bin/env python3
"""Study system helper.

  study new <Subject>            create a subject folder from _template
  study ingest <Subject>         convert new materials into converted/*.md
  study ingest <Subject> --url URL   download a lecture video (yt-dlp), then ingest
  study list                     list subjects
  study index <Subject>          (re)build the semantic index over converted/
  study search <Subject> <query> [-k N]   find the most relevant passages
  study doctor                   check hardware + tools, recommend a search mode (changes nothing)
  study setup [--mode auto|cpu|off]   install semantic search (default: the recommended mode)

Semantic search is optional (see .tools/semantic.py). Once set up, ingest refreshes the index
automatically. The index lives in .tools/index/<Subject>/, the chosen mode in .tools/config.json.

Conversion (skips files already converted and unchanged):
  .pdf                  -> pdftotext, with '--- page N ---' markers
  .pptx .docx .xlsx     -> markitdown (slides keep '<!-- Slide number: N -->')
  .mp4 .mov .mkv .webm .m4a .mp3 .wav
                        -> ffmpeg + whisper.cpp, with [hh:mm:ss] timestamps
  .md .txt              -> copied as is
"""

import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEMPLATE = ROOT / "_template"
MODEL = ROOT / ".tools/models/ggml-large-v3-turbo-q5_0.bin"
VENV_PY = ROOT / ".tools/.venv/bin/python"
SEMANTIC = ROOT / ".tools/semantic.py"
INDEX_DIR = ROOT / ".tools/index"
CONFIG = ROOT / ".tools/config.json"
MIN_RAM_GB, MIN_DISK_GB = 8, 4
SKIP_DIRS = {"_template", ".tools", ".claude", ".git"}

DOC_EXT = {".pptx", ".docx", ".xlsx"}
MEDIA_EXT = {".mp4", ".mov", ".mkv", ".webm", ".m4a", ".mp3", ".wav"}
TEXT_EXT = {".md", ".txt"}


def subjects():
    return sorted(p.name for p in ROOT.iterdir()
                  if p.is_dir() and p.name not in SKIP_DIRS and not p.name.startswith("."))


def subject_dir(name):
    for s in subjects():
        if s.lower() == name.lower():
            return ROOT / s
    sys.exit(f"No subject '{name}'. Existing: {', '.join(subjects()) or 'none'}")


def cmd_new(name):
    dest = ROOT / name
    if dest.exists():
        sys.exit(f"{dest} already exists")
    shutil.copytree(TEMPLATE, dest)
    for f in dest.rglob("*.md"):
        f.write_text(f.read_text().replace("{{SUBJECT}}", name))
    print(f"Created {dest}\nPut files into {dest}/materials/ and run: study ingest {name}")


def pdf_to_md(src, out):
    text = subprocess.run(["pdftotext", "-layout", str(src), "-"],
                          capture_output=True, text=True, check=True).stdout
    pages = text.split("\f")
    body = "\n\n".join(f"--- page {i} ---\n{p.strip()}" for i, p in enumerate(pages, 1) if p.strip())
    if len(text.strip()) < 100 * max(1, len(pages) - 1):
        body += "\n\n> NOTE: little text extracted — likely scanned or image-based. Read the original PDF directly."
    out.write_text(f"# {src.name}\n\nSource: {src}\n\n{body}\n")


def doc_to_md(src, out):
    md = subprocess.run(["markitdown", str(src)], capture_output=True, text=True, check=True).stdout
    out.write_text(f"# {src.name}\n\nSource: {src}\n\n{md}\n")


def srt_to_md(srt, src, out):
    blocks, cur_min, buf = [], None, []
    for m in re.finditer(r"(\d\d):(\d\d):(\d\d)[,.]\d+ -->.*?\n(.*?)(?:\n\n|\Z)", srt.read_text(), re.S):
        h, mi, s, txt = m.groups()
        key = int(h) * 60 + int(mi)
        if cur_min is None or key >= cur_min + 1:
            if buf:
                blocks.append(" ".join(buf))
            buf, cur_min = [f"[{h}:{mi}:{s}]"], key
        buf.append(txt.replace("\n", " ").strip())
    if buf:
        blocks.append(" ".join(buf))
    out.write_text(f"# Transcript: {src.name}\n\nSource: {src}\n\n" + "\n\n".join(blocks) + "\n")


def media_to_md(src, out):
    if not MODEL.exists():
        sys.exit(f"Whisper model missing: {MODEL}")
    with tempfile.TemporaryDirectory() as tmp:
        wav = Path(tmp) / "audio.wav"
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", str(src),
                        "-ar", "16000", "-ac", "1", str(wav)], check=True)
        base = Path(tmp) / "t"
        subprocess.run(["whisper-cli", "-m", str(MODEL), "-f", str(wav), "-l", "auto",
                        "-osrt", "-of", str(base), "-np"],
                       check=True, stdout=subprocess.DEVNULL)
        srt_to_md(base.with_suffix(".srt"), src, out)


def cmd_ingest(name, url=None):
    sd = subject_dir(name)
    mat, conv = sd / "materials", sd / "converted"
    if url:
        (mat / "videos").mkdir(parents=True, exist_ok=True)
        subprocess.run(["yt-dlp", "-x", "--audio-format", "m4a",
                        "-o", str(mat / "videos/%(title)s.%(ext)s"), url], check=True)
    done, skipped, failed = [], 0, []
    for src in sorted(p for p in mat.rglob("*") if p.is_file() and not p.name.startswith(".")):
        ext = src.suffix.lower()
        if ext not in DOC_EXT | MEDIA_EXT | TEXT_EXT | {".pdf"}:
            continue
        out = conv / src.relative_to(mat).with_suffix(src.suffix + ".md")
        if out.exists() and out.stat().st_mtime >= src.stat().st_mtime:
            skipped += 1
            continue
        out.parent.mkdir(parents=True, exist_ok=True)
        print(f"-> {src.relative_to(sd)}", flush=True)
        try:
            if ext == ".pdf":
                pdf_to_md(src, out)
            elif ext in DOC_EXT:
                doc_to_md(src, out)
            elif ext in MEDIA_EXT:
                media_to_md(src, out)
            else:
                shutil.copyfile(src, out)
            done.append(str(out.relative_to(sd)))
        except subprocess.CalledProcessError as e:
            failed.append(f"{src.relative_to(sd)}: {e}")
    print(f"\nConverted {len(done)}, unchanged {skipped}, failed {len(failed)}")
    for d in done:
        print(f"  NEW {d}")
    for f in failed:
        print(f"  FAIL {f}")


def search_mode():
    """'off' | 'auto' | 'cpu' | None (never set up)."""
    if CONFIG.exists():
        return json.loads(CONFIG.read_text()).get("mode")
    return "auto" if VENV_PY.exists() else None


def require_semantic():
    mode = search_mode()
    if mode == "off":
        sys.exit("Semantic search is off on this machine. Use Grep over converted/ instead.")
    if mode is None or not VENV_PY.exists():
        sys.exit("Semantic search is not set up (optional). Use Grep over converted/ for now,\n"
                 "or run `study doctor` to see if this machine can run it, then `study setup`.")


def hardware():
    hw = {"os": platform.system(), "arch": platform.machine(), "cores": os.cpu_count() or 1,
          "python": sys.version_info[:2], "ram_gb": 0.0, "gpu": None,
          "disk_gb": shutil.disk_usage(ROOT).free / 1e9}
    try:
        if hw["os"] == "Darwin":
            hw["ram_gb"] = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True,
                                              text=True).stdout) / 2**30
            if hw["arch"] == "arm64":
                hw["gpu"] = "apple"
        elif hw["os"] == "Linux":
            kb = re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()).group(1)
            hw["ram_gb"] = int(kb) / 2**20
    except (OSError, ValueError, AttributeError):
        pass
    if hw["gpu"] is None and shutil.which("nvidia-smi"):
        hw["gpu"] = "nvidia"
    return hw


def recommend(hw):
    """(mode, reason). Numbers measured on an M2 Pro: search peaks ~1.3 GB RAM, indexing ~3 GB."""
    if hw["os"] not in ("Darwin", "Linux"):
        return "off", "only macOS and Linux are supported (on Windows, use WSL)"
    if hw["os"] == "Darwin" and hw["arch"] != "arm64":
        return "off", "Intel Macs have no current PyTorch build"
    if hw["python"] < (3, 10):
        return "off", "needs Python 3.10 or newer"
    if hw["ram_gb"] and hw["ram_gb"] < MIN_RAM_GB:
        return "off", f"needs at least {MIN_RAM_GB} GB RAM (this machine has {hw['ram_gb']:.0f} GB)"
    if hw["disk_gb"] < MIN_DISK_GB:
        return "off", f"needs ~{MIN_DISK_GB} GB free disk (free: {hw['disk_gb']:.1f} GB)"
    if hw["gpu"]:
        name = "Apple GPU (mps)" if hw["gpu"] == "apple" else "NVIDIA GPU (cuda)"
        return "auto", f"index on the {name}, search on the CPU"
    return "cpu", "no supported GPU: works, but indexing is slow (~1 s per passage)"


def cmd_doctor():
    hw = hardware()
    print("Machine")
    print(f"  {hw['os']} {hw['arch']}, {hw['cores']} cores, {hw['ram_gb']:.0f} GB RAM, "
          f"GPU: {hw['gpu'] or 'none'}, {hw['disk_gb']:.0f} GB free, "
          f"Python {hw['python'][0]}.{hw['python'][1]}")
    print("\nTools (each one is only needed for its file type)")
    for tool, need, fix in [
        ("claude", "the tutor itself", "https://claude.com/claude-code"),
        ("pdftotext", "PDF", "brew install poppler  |  apt install poppler-utils"),
        ("markitdown", "PPTX / DOCX / XLSX", "pip install markitdown"),
        ("ffmpeg", "video / audio", "brew install ffmpeg  |  apt install ffmpeg"),
        ("whisper-cli", "video / audio", "brew install whisper-cpp  (Linux: build whisper.cpp)"),
        ("yt-dlp", "lecture links (--url)", "brew install yt-dlp  |  pip install yt-dlp"),
    ]:
        ok = shutil.which(tool)
        print(f"  {'ok ' if ok else '-- '} {tool:<14} {need:<22} {'' if ok else 'install: ' + fix}")
    print(f"  {'ok ' if MODEL.exists() else '-- '} {'whisper model':<14} {'video / audio':<22} "
          f"{'' if MODEL.exists() else 'download: see README (Requirements)'}")

    mode, why = recommend(hw)
    current = search_mode()
    print("\nSemantic search (optional, local EmbeddingGemma 2)")
    print(f"  current:     {current or 'not set up'}" + ("" if VENV_PY.exists() or current == "off"
                                                        else "  (Grep only)"))
    print(f"  recommended: {mode}  ({why})")
    print("\n  auto = index on GPU, search on CPU · cpu = everything on CPU · off = Grep only")
    if current != mode:
        print(f"\nNext: study setup --mode {mode}")


def cmd_setup(mode=None):
    hw = hardware()
    rec, why = recommend(hw)
    mode = mode or rec
    if mode not in ("auto", "cpu", "off"):
        sys.exit("--mode must be auto, cpu or off")
    if mode != "off" and rec == "off":
        sys.exit(f"Not supported on this machine: {why}. Use --mode off (Grep only).")
    if mode == "auto" and not hw["gpu"]:
        sys.exit("No supported GPU found: use --mode cpu.")
    print(f"Mode: {mode}" + (f"  ({why})" if mode == rec else ""))

    if mode != "off":
        venv_pip = ROOT / ".tools/.venv/bin/pip"
        if not VENV_PY.exists():
            print("-> creating .tools/.venv", flush=True)
            subprocess.run([sys.executable, "-m", "venv", str(ROOT / ".tools/.venv")], check=True)
        if hw["os"] == "Linux" and hw["gpu"] != "nvidia":
            # the default Linux wheel bundles CUDA (~3 GB); the CPU build is ~200 MB
            print("-> installing CPU-only PyTorch", flush=True)
            subprocess.run([str(venv_pip), "install", "-q", "torch",
                            "--index-url", "https://download.pytorch.org/whl/cpu"], check=True)
        print("-> installing sentence-transformers (PyTorch, transformers; ~1 GB)", flush=True)
        subprocess.run([str(venv_pip), "install", "-q", "sentence-transformers[image]"], check=True)

    gpu = {"apple": "mps", "nvidia": "cuda"}.get(hw["gpu"], "cpu")
    devices = {"off": ("off", "off"), "cpu": ("cpu", "cpu"), "auto": (gpu, "cpu")}[mode]
    CONFIG.write_text(json.dumps({"mode": mode, "index_device": devices[0],
                                  "search_device": devices[1]}, indent=2) + "\n")
    print(f"Saved {CONFIG.relative_to(ROOT)}")
    if mode == "off":
        print("The tutor will use Grep over converted/. Run `study setup` again any time to change.")
        return

    print("-> loading the model (first time downloads ~1.5 GB)", flush=True)
    for task in ("index", "search"):
        subprocess.run([str(VENV_PY), str(SEMANTIC), "check", task], check=True)
    for s in subjects():
        if any((ROOT / s / "converted").rglob("*.md")):
            print(f"-> indexing {s}", flush=True)
            cmd_index(s)
    print("Done. Try: study search <Subject> \"<topic in plain words>\"")


def cmd_index(name):
    sd = subject_dir(name)
    require_semantic()
    idx = INDEX_DIR / sd.name
    subprocess.run([str(VENV_PY), str(SEMANTIC), "index", str(sd / "converted"), str(idx)], check=True)


def cmd_search(name, query, k):
    sd = subject_dir(name)
    require_semantic()
    idx = INDEX_DIR / sd.name
    subprocess.run([str(VENV_PY), str(SEMANTIC), "search", str(sd / "converted"), str(idx),
                    str(k), query], check=True)


def main(argv):
    if len(argv) >= 2 and argv[0] == "new":
        cmd_new(" ".join(argv[1:]))
    elif len(argv) >= 2 and argv[0] == "ingest":
        url = argv[argv.index("--url") + 1] if "--url" in argv else None
        cmd_ingest(argv[1], url)
        if VENV_PY.exists() and search_mode() != "off":
            cmd_index(argv[1])
    elif len(argv) >= 2 and argv[0] == "index":
        cmd_index(argv[1])
    elif len(argv) >= 3 and argv[0] == "search":
        rest, k = argv[2:], 5
        if "-k" in rest:
            j = rest.index("-k")
            k, rest = int(rest[j + 1]), rest[:j] + rest[j + 2:]
        cmd_search(argv[1], " ".join(rest), k)
    elif argv[:1] == ["doctor"]:
        cmd_doctor()
    elif argv[:1] == ["setup"]:
        cmd_setup(argv[argv.index("--mode") + 1] if "--mode" in argv else None)
    elif argv[:1] == ["list"]:
        print("\n".join(subjects()) or "no subjects yet")
    else:
        print(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)  # the tool already printed its own message
