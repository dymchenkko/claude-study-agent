        return
    n = text.count("## ")
    print(f"{sd.name}: {n} card(s) from resolved questions\n")
    print(text)


def cmd_queue(name):
    sd = subject_dir(name)
    pending = [i for i in load_queue(sd) if i["status"] == "pending"]
    if not pending:
        print(f"{sd.name}: queue empty.")
        return
    print(f"{sd.name}: {len(pending)} pending")
    for i in pending:
        print(f"  [{i['id']}] ({i['why']}, top {i.get('top')})  {i['q']}")


def write_card(sd, it, answer):
    (sd / "cards").mkdir(exist_ok=True)
    src = it["ctx"][0].split("/")[-1].replace(".pdf", "") if it.get("ctx") else "your notes"
    with open(sd / "cards" / "escalated.md", "a") as f:
        f.write(f"\n## {it['q']}\n_resolved by Claude · {src}_\n\n{answer.strip()}\n")


def claude_cli():
    return shutil.which("claude")


def resolve_with_claude(sd, items):
    """Batch-answer deferred questions with the headless Claude CLI, grounded in retrieved passages."""
    blocks = []
    for it in items:
        ctx = "\n".join(f"[{ref}] {text[:600]}" for _, ref, text in retrieve(sd, it["q"], 6))
        blocks.append(f"@@@ {it['id']}\nQUESTION: {it['q']}\nPASSAGES:\n{ctx}")
    prompt = (
        "You are the student's exam tutor. Answer each QUESTION in 2-4 sentences, grounded ONLY in its "
        "PASSAGES (the student's own course slides), in the same language as the question. Be concrete and "
        "exam-focused; if the passages do not contain the answer, say so in one line. For each question, "
        "output a line '@@@ <id>' then the answer on the next lines. Questions:\n\n" + "\n\n".join(blocks))
    r = subprocess.run([claude_cli(), "-p"], input=prompt, capture_output=True, text=True, timeout=300)
    answers = {}
    for part in r.stdout.split("@@@ ")[1:]:
        head, _, body = part.partition("\n")
        answers[head.strip()] = body.strip()
    return answers


def cmd_drain(name):
    sd = subject_dir(name)
    items = load_queue(sd)
    pending = [i for i in items if i["status"] == "pending"]
    if not pending:
        print("Nothing to drain.")
        return
    if not online():
        print(f"Offline — {len(pending)} question(s) waiting. They'll resolve when you reconnect.")
        return
    if claude_cli():
        print(f"Online — asking Claude to clear {len(pending)} question(s)...", flush=True)
        answers = resolve_with_claude(sd, pending)
        done = 0
        for it in pending:
            if answers.get(it["id"]):
                write_card(sd, it, answers[it["id"]])
                it["status"] = "resolved"
                done += 1
        save_queue(sd, items)
        print(f"Done — {done} answer(s) now in {sd.name}/cards/.  (see: study cards {sd.name})")
        return
    # no claude CLI: prepare a batch for a manual Claude Code session
    batch = sd / ".drain-batch.md"
    out = [f"# Escalation batch — {sd.name} — {time.strftime('%Y-%m-%d %H:%M')}", ""]
    for i in pending:
        out += [f"## [{i['id']}] {i['q']}", f"- sources: {', '.join(i['ctx'])}", ""]
        i["status"] = "ready"
    batch.write_text("\n".join(out))
    save_queue(sd, items)
    print(f"Online — {len(pending)} ready, but the `claude` CLI isn't on PATH. Batch at "
          f"{batch.relative_to(ROOT)} for a Claude Code session.")


def cmd_watch(name):
    sd = subject_dir(name)
    print(f"Watching the connection for {sd.name}. Deferred questions resolve by themselves when you're "
          f"back online. Ctrl-C to stop.")
    was = online()
    try:
        while True:
            time.sleep(15)
            now = online()
            pend = sum(i["status"] == "pending" for i in load_queue(sd))
            if now and not was and pend:
                print(f"[{time.strftime('%H:%M')}] back online — clearing {pend} queued question(s)...")
                cmd_drain(name)
            was = now
    except KeyboardInterrupt:
        print("\nstopped.")


def cmd_resolve(name, qid, answer):
    sd = subject_dir(name)
    items = load_queue(sd)
    it = next((i for i in items if i["id"] == qid), None)
    if not it:
        sys.exit(f"No queued item {qid} in {sd.name}.")
    answer = (answer or sys.stdin.read()).strip()
    if not answer:
        sys.exit("No answer text (pass it as an argument or on stdin).")
    write_card(sd, it, answer)
    it["status"] = "resolved"
    save_queue(sd, items)
    left = sum(i["status"] in ("pending", "ready") for i in items)
    print(f"Card written to {sd.name}/cards/escalated.md; {qid} resolved. [{left} still open]")


def main(argv):
    if len(argv) >= 2 and argv[0] == "new":
        cmd_new(" ".join(argv[1:]))
    elif len(argv) >= 2 and argv[0] == "ingest":
        url = argv[argv.index("--url") + 1] if "--url" in argv else None
        cmd_ingest(argv[1], url)
        if search_ready():
            cmd_index(argv[1])
    elif len(argv) >= 2 and argv[0] == "index":
        cmd_index(argv[1])
    elif len(argv) >= 3 and argv[0] == "search":
        rest, k = argv[2:], 5
        if "-k" in rest:
            j = rest.index("-k")
            k, rest = int(rest[j + 1]), rest[:j] + rest[j + 2:]
        cmd_search(argv[1], " ".join(rest), k)
    elif len(argv) >= 3 and argv[0] == "ask":
        cmd_ask(argv[1], " ".join(argv[2:]))
    elif len(argv) == 2 and argv[0] == "tutor":
        cmd_tutor_repl(argv[1])
    elif len(argv) >= 3 and argv[0] == "tutor":
        cmd_tutor(argv[1], " ".join(argv[2:]))
    elif len(argv) == 2 and argv[0] == "queue":
        cmd_queue(argv[1])
    elif len(argv) == 2 and argv[0] == "cards":
        cmd_cards(argv[1])
    elif len(argv) == 2 and argv[0] == "drain":
        cmd_drain(argv[1])
    elif len(argv) == 2 and argv[0] == "watch":
        cmd_watch(argv[1])
    elif len(argv) >= 3 and argv[0] == "resolve":
        cmd_resolve(argv[1], argv[2], " ".join(argv[3:]) if len(argv) > 3 else None)
    elif argv[:1] == ["doctor"]:
        cmd_doctor()
    elif argv[:1] == ["setup"]:
        cmd_setup(argv[argv.index("--mode") + 1] if "--mode" in argv else None)
    elif argv[:1] == ["list"]:
        print("\n".join(subjects()) or "no subjects yet")
    else:
        print(__doc__)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)  # the tool already printed its own message
