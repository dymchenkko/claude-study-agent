def _load_reason_re():
    """Fallback reasoning detector, only used when no local chat model is installed (then there is
    no self-consistency vote). Patterns load from .tools/reason-words.txt (gitignored) if present,
    else a small English default. One regex fragment per line, joined as a case-insensitive
    alternation. Stems only (no trailing \\b) so "differ" matches "difference"; the leading \\b keeps
    them word-initial. Returns None when the list is empty."""
    f = ROOT / ".tools/reason-words.txt"
    default = ["why", "how", "compare", "contrast", "deriv", "prove", "explain", "differ",
               "relat", "evaluat", "reason"]
    words = ([l.strip() for l in f.read_text().splitlines() if l.strip() and not l.startswith("#")]
             if f.exists() else default)
    return re.compile(r"\b(" + "|".join(words) + ")", re.I) if words else None


REASON_RE = _load_reason_re()

DOC_EXT = {".pptx", ".docx", ".xlsx"}
MEDIA_EXT = {".mp4", ".mov", ".mkv", ".webm", ".m4a", ".mp3", ".wav"}
TEXT_EXT = {".md", ".txt"}


def subjects():
    return sorted(p.name for p in ROOT.iterdir()
                  if p.is_dir() and p.name not in SKIP_DIRS and not p.name.startswith("."))


def subject_dir(name):
    for s in subjects():
        if s.lower() == name.lower():
            return ROOT / s
    sys.exit(f"No subject '{name}'. Existing: {', '.join(subjects()) or 'none'}")


def cmd_new(name):
    dest = ROOT / name
    if dest.exists():
        sys.exit(f"{dest} already exists")
    shutil.copytree(TEMPLATE, dest)
    for f in dest.rglob("*.md"):
        f.write_text(f.read_text().replace("{{SUBJECT}}", name))
    print(f"Created {dest}\nPut files into {dest}/materials/ and run: study ingest {name}")


# Old LaTeX PDFs (T1 font encoding, no ToUnicode map) come out of pdftotext as "Przykªad",
# "Wªasno±ci" and "klasy\x1ckacji". The T1 code points map back exactly.
T1 = str.maketrans({
    "\x10": "“", "\x11": "”", "\x15": "–", "\x16": "—",
    "\x1b": "ff", "\x1c": "fi", "\x1d": "fl", "\x1e": "ffi", "\x1f": "ffl",
    "\x81": "Ą", "\x82": "Ć", "\x86": "Ę", "\x8a": "Ł", "\x8b": "Ń", "\x91": "Ś", "\x99": "Ź", "\x9b": "Ż",
    "¡": "ą", "¢": "ć", "¦": "ę", "ª": "ł", "«": "ń", "±": "ś", "¹": "ź", "»": "ż"})
T1_SIGN = re.compile(r"[A-Za-z][ª±¦¡¢»\x1c][A-Za-z]")


def fix_t1(text):
    return text.translate(T1) if len(T1_SIGN.findall(text)) >= 5 else text


def readable(page):
    """Characters of real text on a page; 0 when it is mostly undecodable glyphs."""
    s = "".join(page.split())
    bad = sum(ch == "\ufffd" or ord(ch) < 32 for ch in s)
    return 0 if bad > len(s) * 0.1 else len(s)


_ocr = []


def ocr_backend():
    """'vision' | 'tesseract' | None. Builds the Vision helper once (needs Xcode command line tools)."""
    if not _ocr:
        backend = None
        if platform.system() == "Darwin" and shutil.which("swiftc") and OCR_SRC.exists():
            if not OCR_BIN.exists() or OCR_BIN.stat().st_mtime < OCR_SRC.stat().st_mtime:
                print("   building the OCR helper (once)", flush=True)
                OCR_BIN.parent.mkdir(exist_ok=True)
                r = subprocess.run(["swiftc", "-O", str(OCR_SRC), "-o", str(OCR_BIN)],
                                   capture_output=True, text=True)
                if r.returncode:
                    print(f"   OCR helper failed to build:\n{r.stderr[-500:]}", flush=True)
            if OCR_BIN.exists():
                backend = "vision"
        if not backend and shutil.which("tesseract") and shutil.which("pdftoppm"):
            backend = "tesseract"
        _ocr.append(backend)
    return _ocr[0]


def ocr_pages(src, nums):
    """{page number: text} for the given 1-based pages."""
    langs = os.environ.get("STUDY_OCR_LANGS")
    if ocr_backend() == "vision":
        r = subprocess.run([str(OCR_BIN), str(src), ",".join(map(str, nums)), langs or "auto"],
                           capture_output=True, text=True, check=True)
        return {int(k): v for k, v in json.loads(r.stdout).items()}
    found = {}
    with tempfile.TemporaryDirectory() as tmp:
        for n in nums:
            img = Path(tmp) / "page"
            subprocess.run(["pdftoppm", "-r", "300", "-f", str(n), "-l", str(n), "-png", "-singlefile",
                            str(src), str(img)], check=True)
            found[n] = subprocess.run(["tesseract", str(img) + ".png", "-", "-l", langs or "eng"],
                                      capture_output=True, text=True, check=True).stdout
    return found


def pdf_to_md(src, out):
    text = subprocess.run(["pdftotext", "-layout", str(src), "-"],
                          capture_output=True, text=True, check=True).stdout
    pages = fix_t1(text).split("\f")
    if len(pages) > 1 and not pages[-1].strip():
        pages.pop()  # pdftotext ends every page with a form feed
    thin = [i for i, p in enumerate(pages, 1) if readable(p) < THIN_PAGE]
    notes = []
    if thin and ocr_backend():
        print(f"   OCR {len(thin)} page(s) without a text layer (~2 s each)", flush=True)
        for i, t in ocr_pages(src, thin).items():
            if readable(t) > readable(pages[i - 1]):
                pages[i - 1] = t
        done = [i for i in thin if readable(pages[i - 1]) >= THIN_PAGE]
        if done:
            notes.append(f"> OCR: {len(done)} page(s) read from images — "
                         "check formulas and tables against the original.")
    still_thin = sum(readable(p) < THIN_PAGE for p in pages)
    if still_thin > len(pages) / 2:
        notes.append(NOTE_AFTER_OCR if thin and ocr_backend() else NOTE_NO_OCR)
    body = "\n\n".join(f"--- page {i} ---\n{p.strip()}" for i, p in enumerate(pages, 1) if readable(p))
    head = "".join(n + "\n\n" for n in notes)
    out.write_text(f"# {src.name}\n\nSource: {src.relative_to(ROOT)}\n\n{head}{body}\n")


def doc_to_md(src, out):
    md = subprocess.run(["markitdown", str(src)], capture_output=True, text=True, check=True).stdout
    out.write_text(f"# {src.name}\n\nSource: {src.relative_to(ROOT)}\n\n{md}\n")


def srt_to_md(srt, src, out):
    blocks, cur_min, buf = [], None, []
    for m in re.finditer(r"(\d\d):(\d\d):(\d\d)[,.]\d+ -->.*?\n(.*?)(?:\n\n|\Z)", srt.read_text(), re.S):
        h, mi, s, txt = m.groups()
        key = int(h) * 60 + int(mi)
        if cur_min is None or key >= cur_min + 1:
            if buf:
                blocks.append(" ".join(buf))
            buf, cur_min = [f"[{h}:{mi}:{s}]"], key
        buf.append(txt.replace("\n", " ").strip())
    if buf:
        blocks.append(" ".join(buf))
    out.write_text(f"# Transcript: {src.name}\n\nSource: {src.relative_to(ROOT)}\n\n" + "\n\n".join(blocks) + "\n")


def media_to_md(src, out):
    if not MODEL.exists():
        sys.exit(f"Whisper model missing: {MODEL}")
    with tempfile.TemporaryDirectory() as tmp:
        wav = Path(tmp) / "audio.wav"
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", str(src),
                        "-ar", "16000", "-ac", "1", str(wav)], check=True)
        base = Path(tmp) / "t"
        subprocess.run(["whisper-cli", "-m", str(MODEL), "-f", str(wav), "-l", "auto",
                        "-osrt", "-of", str(base), "-np"],
                       check=True, stdout=subprocess.DEVNULL)
        srt_to_md(base.with_suffix(".srt"), src, out)


def cmd_ingest(name, url=None):
    sd = subject_dir(name)
    mat, conv = sd / "materials", sd / "converted"
    if url:
        (mat / "videos").mkdir(parents=True, exist_ok=True)
        subprocess.run(["yt-dlp", "-x", "--audio-format", "m4a",
                        "-o", str(mat / "videos/%(title)s.%(ext)s"), url], check=True)
    done, skipped, failed = [], 0, []
    for src in sorted(p for p in mat.rglob("*") if p.is_file() and not p.name.startswith(".")):
        ext = src.suffix.lower()
        if ext not in DOC_EXT | MEDIA_EXT | TEXT_EXT | {".pdf"}:
            continue
        out = conv / src.relative_to(mat).with_suffix(src.suffix + ".md")
        up_to_date = out.exists() and out.stat().st_mtime >= src.stat().st_mtime
        if up_to_date and ext == ".pdf" and NOTE_NO_OCR in out.read_text(errors="replace"):
            up_to_date = not ocr_backend()  # converted before OCR was available: redo it
        if up_to_date:
            skipped += 1
            continue
        out.parent.mkdir(parents=True, exist_ok=True)
        print(f"-> {src.relative_to(sd)}", flush=True)
        try:
            if ext == ".pdf":
                pdf_to_md(src, out)
            elif ext in DOC_EXT:
                doc_to_md(src, out)
            elif ext in MEDIA_EXT:
                media_to_md(src, out)
            else:
                shutil.copyfile(src, out)
            done.append(str(out.relative_to(sd)))
        except subprocess.CalledProcessError as e:
            failed.append(f"{src.relative_to(sd)}: {e}")
    print(f"\nConverted {len(done)}, unchanged {skipped}, failed {len(failed)}")
    for d in done:
        print(f"  NEW {d}")
    for f in failed:
        print(f"  FAIL {f}")
    sys.stdout.flush()  # before the index subprocess writes


def search_mode():
    """'off' | 'auto' | 'cpu' | None (never set up)."""
    if CONFIG.exists():
        return json.loads(CONFIG.read_text()).get("mode")
    return "auto" if semantic.installed() else None


def search_ready():
    return search_mode() != "off" and semantic.installed()


def require_semantic():
    mode = search_mode()
    if mode == "off":
        sys.exit("Semantic search is off on this machine. Use Grep over converted/ instead.")
    if not semantic.installed():
        old = (ROOT / ".tools/.venv").exists()
        sys.exit(("Semantic search moved from PyTorch to llama.cpp (~330 MB instead of ~2.6 GB).\n"
                  "Run `study setup` once to switch; then .tools/.venv can be deleted."
                  if old else
                  "Semantic search is not set up (optional). Use Grep over converted/ for now,\n"
                  "or run `study doctor` to see if this machine can run it, then `study setup`."))


def hardware():
    hw = {"os": platform.system(), "arch": platform.machine(), "cores": os.cpu_count() or 1,
          "python": sys.version_info[:2], "ram_gb": 0.0, "gpu": None,
          "disk_gb": shutil.disk_usage(ROOT).free / 1e9}
    try:
        if hw["os"] == "Darwin":
            hw["ram_gb"] = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True,
                                              text=True).stdout) / 2**30
            if hw["arch"] == "arm64":
                hw["gpu"] = "apple"
        elif hw["os"] == "Linux":
            kb = re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()).group(1)
            hw["ram_gb"] = int(kb) / 2**20
    except (OSError, ValueError, AttributeError):
        pass
    if hw["gpu"] is None and shutil.which("nvidia-smi"):
        hw["gpu"] = "nvidia"
    return hw


def recommend(hw):
    """(mode, reason). Measured on an M2 Pro: ~0.6 GB RAM while running, nothing between searches."""
    if (hw["os"], hw["arch"]) not in semantic.LLAMA_ASSETS:
        return "off", f"no prebuilt llama.cpp for {hw['os']} {hw['arch']}"
    if hw["python"] < (3, 10):
        return "off", "needs Python 3.10 or newer"
    if hw["ram_gb"] and hw["ram_gb"] < MIN_RAM_GB:
        return "off", f"needs at least {MIN_RAM_GB} GB RAM (this machine has {hw['ram_gb']:.0f} GB)"
    if hw["disk_gb"] < MIN_DISK_GB:
        return "off", f"needs ~{MIN_DISK_GB} GB free disk (free: {hw['disk_gb']:.1f} GB)"
    if hw["gpu"] == "apple":
        return "auto", "uses the Apple GPU when it helps"
    return "cpu", "no GPU needed: indexing ~0.1 s per passage, each search ~1.5 s"


def tutor_backends():
    """Agent-neutral: which backend could drive the tutor skills. Returns (working, notes).

    A local OpenAI-compatible endpoint is used when STUDY_TUTOR_URL is set and reachable;
    otherwise any installed agent CLI (Claude Code or Gemini CLI) can run the skills."""
    working, notes = [], []
    url = os.environ.get("STUDY_TUTOR_URL")
    if url:
        try:
            import urllib.error
            import urllib.request
            try:
                urllib.request.urlopen(url, timeout=1.5).close()
            except urllib.error.HTTPError:
                pass  # the server answered (e.g. 404): it is reachable
            working.append(f"local endpoint ({url})")
        except Exception:
            notes.append(f"STUDY_TUTOR_URL={url} is set but not reachable")
    if shutil.which("claude"):
        working.append("Claude Code (claude)")
    if shutil.which("gemini"):
        working.append("Gemini CLI (gemini)")
    return working, notes


