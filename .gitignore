# Your own subjects (materials, notes, progress, mistakes) stay local.
# Only the blank template and the demo subject are tracked.
/*/
!/_template/
!/Example-Subject/
!/.claude/
!/.tools/
!/docs/
!/.github/
!/anna/

# Downloaded models and llama.cpp, old semantic-search env, index and per-machine config
.tools/models/
.tools/llama/
.tools/.venv/
.tools/index/
.tools/config.json
.tools/bin/
__pycache__/
*.pyc

# OS and local settings
.DS_Store
.claude/settings.local.json

# study-tools binary builds (anna-app branch)
anna/study-tools/build/
anna/study-tools/dist/
anna/study-tools/*.spec
