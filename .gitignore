# Your own subjects (materials, notes, progress, mistakes) stay local.
# Only the blank template and the demo subject are tracked.
/*/
!/_template/
!/Example-Subject/
!/.claude/
!/.tools/

# Downloaded models, semantic-search env, index and per-machine config
.tools/models/
.tools/.venv/
.tools/index/
.tools/config.json
__pycache__/
*.pyc

# OS and local settings
.DS_Store
.claude/settings.local.json
